+// cuts on the lattice, each moved to the strongest edge within a fifth of a pixel (drifting AI art), never closer than
+// half a pixel to the last; edge cells narrower than half a pixel join their neighbour
+fn place_cuts(profile: &[f64], step: f64, phase: f64, limit: usize) -> Vec<usize> {
+    let r = if step >= 3.0 { (step * 0.2).round() as usize } else { 0 };
+    let mut cuts = vec![0usize];
+    let mut k = 0.0;
+    loop {
+        let x = phase + k * step;
+        k += 1.0;
+        if x < step * 0.5 { continue; }
+        if x > limit as f64 - step * 0.5 { break; }
+        let i = x.round() as usize;
+        let (lo, hi) = (i.saturating_sub(r).max(1), (i + r).min(limit - 1));
+        let mut best = i.min(limit - 1);
+        for j in lo..=hi { if profile[j] > profile[best] { best = j; } }
+        let last = *cuts.last().unwrap();
+        if (best as f64) - (last as f64) >= step * 0.5 { cuts.push(best); }
