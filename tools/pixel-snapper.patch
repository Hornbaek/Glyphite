-
-    if clean_peaks.len() < 2 {
-        return None;
-    }
-
-    // Compute diffs
-    let mut diffs: Vec<f64> = clean_peaks
-        .windows(2)
-        .map(|w| (w[1] - w[0]) as f64)
-        .collect();
-
-    // Median
-    diffs.sort_by(|a, b| a.partial_cmp(b).unwrap_or(Ordering::Equal));
-    Some(diffs[diffs.len() / 2])
+// The grid an upscaled drawing was made on is a lattice: a cut every `step` pixels from an offset, and the edges in the
+// drawing (colour changes: the profile) lie on its lines. A lattice is scored by how much of all the edge energy its lines
+// explain, minus a small cost per line: the true size explains nearly all of it with the fewest lines; half of it explains
+// the same with twice the lines; twice it misses the edges between its lines; a big size explains little.
+fn lattice_explained(profile: &[f64], step: f64, phase: f64) -> (f64, usize) {
+    let n = profile.len();
+    let (mut e, mut lines) = (0.0, 0usize);
+    let mut k = 0.0;
+    loop {
+        let x = (phase + k * step).round();
+        if x >= n as f64 { break; }
+        let i = x as usize;
+        e += profile[i];   // one column per line at every size, so no size gets more columns to explain with
+        lines += 1; k += 1.0;
+    }
+    (e, lines)
 }
 
